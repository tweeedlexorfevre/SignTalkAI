{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "signtalk-api",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "PORT=5331",
        "node",
        "server/app.mjs"
      ],
      "port": 5331
    },
    {
      "name": "signtalk",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "server/app.mjs"
      ],
      "port": 5331
    },
    {
      "name": "signtalk-dev",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "tools/dev.mjs"
      ],
      "port": 5330
    },
    {
      "name": "signtalk-tunnel",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "TRUST_PROXY=1",
        "PORT=5332",
