        "node",
        "server/app.mjs"
      ],
      "port": 5332
    },
    {
      "name": "signtalk-5338",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "server/app.mjs",
        "5338"
      ],
      "port": 5338
    },
    {
      "name": "signtalk-api-local",
      "runtimeExecutable": "env",
