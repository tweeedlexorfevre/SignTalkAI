# Copy to .env.local (never commit it). Everything here is optional.

# Messenger database. With DATABASE_URL set, the server uses PostgreSQL (Supabase):
# Supabase → Connect → "Session pooler" URI, with your database password filled in.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# Without DATABASE_URL it falls back to a local SQLite file. Default: ./data/signtalk.db
# DATABASE_PATH=./data/signtalk.db

# Listen address. Default 127.0.0.1 (this computer only); 0.0.0.0 for the local network.
# HOST=127.0.0.1
# PORT=5331

# Messenger administrators: comma-separated account usernames (not display names).
# After setting this, restart the server and sign in again with that account.
# ADMIN_USERNAMES=dastan,admin,moderator

# TURN relay for video calls across strict NATs (comma-separated URLs).
# TURN_URLS=turn:turn.example.com:3478
# TURN_USERNAME=
# TURN_CREDENTIAL=
